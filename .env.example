# Yandex OAuth (https://oauth.yandex.ru/) — all four are required, otherwise
# login is shown as "unavailable" and no fake session is ever created.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Public origin of the app (https in production). The Redirect URI registered
# in the Yandex app must be exactly: ${AUTH_URL}/api/auth/yandex/callback
AUTH_URL=http://localhost:3000

# >= 32 random chars, used to sign the session cookie: `openssl rand -base64 48`
AUTH_SECRET=
